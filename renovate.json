{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":timezone(Europe/Paris)"
  ],
  "schedule": ["before 7am on monday"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "SQL Server images pinned in SqlServerImages.cs and the integration test fixture",
      "customType": "regex",
      "managerFilePatterns": [
        "/src/MsSqlOperator/Configuration/SqlServerImages\\.cs$/",
        "/src/MsSqlOperator\\.IntegrationTests/SqlServerFixture\\.cs$/"
      ],
      "matchStrings": [
        "(?<depName>mcr\\.microsoft\\.com/mssql/server):(?<currentValue>[^\"]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "nuget (minor/patch)"
    }
  ]
}
