root = true

[*.cs]
# CA2100 (review SQL for injection) fires on every non-constant CommandText, even when
# properly protected. All dynamic SQL goes through SqlQuoting (identifiers/literals/allowlists)
# or SqlParameters — keep as suggestion so new call sites stay visible without failing builds.
dotnet_diagnostic.CA2100.severity = suggestion

[MsSqlOperator/Services/GitHub/GitHubContentFetcher.cs]
# SHA-1 here is git's object-id format: blob integrity is verified against the SHA announced
# by the Trees API (sha1("blob {len}\0" + content)). Not an operator cryptographic choice.
dotnet_diagnostic.CA5350.severity = none

[*.cs]
# XML docs are generated for CRD descriptions; undocumented members are fine.
dotnet_diagnostic.CS1591.severity = none
