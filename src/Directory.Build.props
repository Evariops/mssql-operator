<Project>

  <PropertyGroup>
    <!-- Security analyzers always on: all CA security rules enabled at latest level -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Build gate: no warning ships. Severity tuning belongs in .editorconfig. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
